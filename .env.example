# Copy to .env and fill in. The code reads these from the environment; it never
# stores credentials in source. A key is OPTIONAL for OpenAlex (the polite pool
# only needs a contact email), but a key raises rate limits.

# Optional OpenAlex API key (premium / higher limits). Leave empty to use the polite pool.
OPENALEX_API_KEY=

# Contact email for the OpenAlex "polite pool" (required for good throughput).
# OpenAlex asks every automated client to identify itself with a mailto.
OPENALEX_MAILTO=your-email@example.org
